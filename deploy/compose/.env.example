# Nuxx production Docker Compose environment.
# Copy to .env and replace every CHANGE_ME value before running.
# The bootstrap script should generate this file for normal users.

# Image published by the public image pipeline. Use `:main` for pre-release testing. Pin `:sha-<7>` or a semver release tag for production.
NUXX_IMAGE=ghcr.io/tkrnkym/nuxx:main

# Public host name. Used by compose.caddy.yml and URL-derived settings below.
NUXX_DOMAIN=nuxx.example.com
RELAY_URL=wss://nuxx.example.com
NUXX_MEDIA_BASE_URL=https://nuxx.example.com/media
NUXX_MEDIA_SERVER_DOMAIN=nuxx.example.com
NUXX_CORS_ORIGINS=https://nuxx.example.com

# Production defaults. Closed relay mode requires RELAY_OWNER_PUBKEY and a stable relay key.
NUXX_REQUIRE_AUTH_TOKEN=true
NUXX_REQUIRE_RELAY_MEMBERSHIP=true
NUXX_ALLOW_NIP_OA_AUTH=true
NUXX_AUTO_MIGRATE=true
NUXX_GIT_CONFORMANCE_PROBE=true
RUST_LOG=nuxx_relay=info,nuxx_db=info,nuxx_auth=info,nuxx_pubsub=info,tower_http=info

# Owner identity. Set to a 64-character hex Nostr pubkey.
RELAY_OWNER_PUBKEY=CHANGE_ME_OWNER_PUBKEY_HEX

# Stable secrets. Generate once, keep in .env, and back up securely.
NUXX_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX_PRIVATE_KEY
NUXX_GIT_HOOK_HMAC_SECRET=CHANGE_ME_RANDOM_64_HEX
POSTGRES_DB=nuxx
POSTGRES_USER=nuxx
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
REDIS_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
NUXX_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
NUXX_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
NUXX_S3_BUCKET=nuxx-media
# Bundled MinIO uses path-style URLs; deploy/compose/compose.yml pins this.
NUXX_S3_ADDRESSING_STYLE=path

# Optional host ports. Base compose publishes the relay directly on NUXX_HTTP_PORT.
NUXX_HTTP_PORT=3000

# Caddy host ports. Only used with compose.caddy.yml.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Dev override ports. Only used with compose.dev.yml.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ADMINER_PORT=8082
PROMETHEUS_PORT=9090
